AWS_REGION=us-east-1
# Model ID is configuration, not code - demonstrates model portability
BEDROCK_MODEL_ID=anthropic.claude-sonnet-example-model-id
APP_ENV=dev
LOG_LEVEL=INFO
# dev mode only: full content logging with synthetic data (never in prod)
LOG_FULL_CONTENT=false
# Embeddings
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
# Vector store (local dev; production uses Secrets Manager)
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35
